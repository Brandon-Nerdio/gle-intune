{
    "@odata.type": "#microsoft.graph.conditionalAccessPolicy",
    "displayName": "CE-H-UAC-CA-006 - Block Non Compliant Devices [Hardening] [Enforced]",
    "state": "enabled",
    "conditions": {
        "applications": {
            "includeApplications": [
                "All"
            ]
        },
        "users": {
            "includeUsers": [
                "All"
            ],
            "excludeGroups": [
                "{$GroupVars.BreakGlass}"
            ]
        },
        "clientAppTypes": [
            "all"
        ],
        "platforms": {
            "includePlatforms": [
                "all"
            ],
            "excludePlatforms": [
                "android",
                "iOS",
                "macOS",
                "linux"
            ]
        }
    },
    "grantControls": {
        "operator": "OR",
        "builtInControls": [
            "compliantDevice"
        ]
    },
    "description": "Hardening Cyber Essentials pack policy."
}
