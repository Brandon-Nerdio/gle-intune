{
    "@odata.type": "#microsoft.graph.conditionalAccessPolicy",
    "displayName": "CE-H-UAC-CA-002 - Require multifactor authentication for all users [Hardening] [Enforced]",
    "state": "enabled",
    "conditions": {
        "applications": {
            "includeApplications": [
                "All"
            ]
        },
        "users": {
            "includeUsers": [
                "All"
            ],
            "excludeGroups": [
                "{$GroupVars.BreakGlass}"
            ]
        },
        "clientAppTypes": [
            "all"
        ]
    },
    "grantControls": {
        "operator": "OR",
        "builtInControls": [
            "mfa"
        ]
    },
    "description": "Hardening Cyber Essentials pack policy."
}
