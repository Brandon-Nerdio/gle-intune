{
    "@odata.type":  "#microsoft.graph.conditionalAccessPolicy",
    "displayName":  "CE-UAC-CA-007 - Block Devices not joined to EntraID",
    "state":  "enabledForReportingButNotEnforced",
    "conditions":  {
                       "applications":  {
                                            "includeApplications":  [
                                                                        "All"
                                                                    ]
                                        },
                       "users":  {
                                     "includeUsers":  [
                                                          "All"
                                                      ]
                                 },
                       "clientAppTypes":  [
                                              "all"
                                          ],
                       "devices":  {
                                       "deviceFilter":  {
                                                            "mode":  "exclude",
                                                            "rule":  "device.trustType -eq \"AzureAD\""
                                                        }
                                   }
                   },
    "grantControls":  {
                          "operator":  "OR",
                          "builtInControls":  [
                                                  "block"
                                              ]
                      }
}