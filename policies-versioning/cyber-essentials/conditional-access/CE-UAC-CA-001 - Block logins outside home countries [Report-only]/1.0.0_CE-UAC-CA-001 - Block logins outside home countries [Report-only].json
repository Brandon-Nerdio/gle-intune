{
    "@odata.type": "#microsoft.graph.conditionalAccessPolicy",
    "displayName": "CE-UAC-CA-001 - Block logins outside home countries [Report-only]",
    "description": "Report-only variant of 'CE-UAC-CA-001 - Block logins outside home countries'. Evaluates and logs matching sign-ins without enforcing access controls. Validate its results before deploying the enforced counterpart.",
    "state": "enabledForReportingButNotEnforced",
    "conditions": {
        "applications": {
            "includeApplications": [
                "All"
            ]
        },
        "users": {
            "includeUsers": [
                "All"
            ],
            "excludeGroups": [
                "{$GroupVars.BreakGlass}"
            ]
        },
        "clientAppTypes": [
            "all"
        ],
        "locations": {
            "includeLocations": [
                "All"
            ],
            "excludeLocations": [
                "{$LocationVars.HomeCountries}"
            ]
        }
    },
    "grantControls": {
        "operator": "OR",
        "builtInControls": [
            "block"
        ]
    }
}
