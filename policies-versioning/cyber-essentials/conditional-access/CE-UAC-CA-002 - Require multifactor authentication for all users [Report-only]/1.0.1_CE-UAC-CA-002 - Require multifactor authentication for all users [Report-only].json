{
    "@odata.type":  "#microsoft.graph.conditionalAccessPolicy",
    "displayName":  "CE-UAC-CA-002 - Require multifactor authentication for all users [Report-only]",
    "state":  "enabledForReportingButNotEnforced",
    "conditions":  {
                       "applications":  {
                                            "includeApplications":  [
                                                                        "All"
                                                                    ]
                                        },
                       "users":  {
                                     "includeUsers":  [
                                                          "All"
                                                      ],
                                     "excludeGroups":  [
                                                           "{$GroupVars.BreakGlass}"
                                                       ]
                                 },
                       "clientAppTypes":  [
                                              "all"
                                          ]
                   },
    "grantControls":  {
                          "operator":  "OR",
                          "builtInControls":  [
                                                  "mfa"
                                              ]
                      }
}
