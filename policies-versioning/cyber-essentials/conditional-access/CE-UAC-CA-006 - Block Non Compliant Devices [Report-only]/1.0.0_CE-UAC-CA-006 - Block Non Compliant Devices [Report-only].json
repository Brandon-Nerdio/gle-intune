{
    "@odata.type": "#microsoft.graph.conditionalAccessPolicy",
    "displayName": "CE-UAC-CA-006 - Block Non Compliant Devices [Report-only]",
    "description": "Report-only variant of 'CE-UAC-CA-006 - Block Non Compliant Devices'. Evaluates and logs matching sign-ins without enforcing access controls. Validate its results before deploying the enforced counterpart.",
    "state": "enabledForReportingButNotEnforced",
    "conditions": {
        "applications": {
            "includeApplications": [
                "All"
            ]
        },
        "users": {
            "includeUsers": [
                "All"
            ],
            "excludeGroups": [
                "{$GroupVars.BreakGlass}"
            ]
        },
        "clientAppTypes": [
            "all"
        ],
        "platforms": {
            "includePlatforms": [
                "all"
            ],
            "excludePlatforms": [
                "android",
                "iOS",
                "macOS",
                "linux"
            ]
        }
    },
    "grantControls": {
        "operator": "OR",
        "builtInControls": [
            "compliantDevice"
        ]
    }
}
