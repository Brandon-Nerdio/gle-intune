{
    "@odata.type": "#microsoft.graph.conditionalAccessPolicy",
    "displayName": "CE-UAC-CA-007 - Block Devices not joined to EntraID [Enforced]",
    "description": "Enforced variant of 'CE-UAC-CA-007 - Block Devices not joined to EntraID'. Applies its access controls when conditions match and can block or challenge sign-ins. Deploy only after validating the report-only counterpart.",
    "state": "enabled",
    "conditions": {
        "applications": {
            "includeApplications": [
                "All"
            ]
        },
        "users": {
            "includeUsers": [
                "All"
            ],
            "excludeGroups": [
                "{$GroupVars.BreakGlass}"
            ]
        },
        "clientAppTypes": [
            "all"
        ],
        "devices": {
            "deviceFilter": {
                "mode": "exclude",
                "rule": "device.trustType -eq \"AzureAD\""
            }
        }
    },
    "grantControls": {
        "operator": "OR",
        "builtInControls": [
            "block"
        ]
    }
}
