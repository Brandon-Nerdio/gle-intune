{
    "@odata.type": "#microsoft.graph.conditionalAccessPolicy",
    "displayName": "CE-UAC-CA-008 - Grant Access to All Apps for Hybrid devices [Enforced]",
    "description": "Enforced variant of 'CE-UAC-CA-008 - Grant Access to All Apps for Hybrid devices'. Applies its access controls when conditions match and can block or challenge sign-ins. Deploy only after validating the report-only counterpart.",
    "state": "enabled",
    "conditions": {
        "applications": {
            "includeApplications": [
                "All"
            ]
        },
        "users": {
            "includeUsers": [
                "All"
            ],
            "excludeGroups": [
                "{$GroupVars.BreakGlass}"
            ]
        },
        "clientAppTypes": [
            "all"
        ],
        "platforms": {
            "includePlatforms": [
                "windows"
            ],
            "excludePlatforms": [
                "android",
                "iOS",
                "windowsPhone",
                "macOS",
                "linux"
            ]
        }
    },
    "grantControls": {
        "operator": "OR",
        "builtInControls": [
            "domainJoinedDevice"
        ]
    }
}
