{
    "@odata.type": "#microsoft.graph.conditionalAccessPolicy",
    "displayName": "CE-F-UAC-CA-005 - Block legacy authentication [Foundation] [Report-only]",
    "state": "enabledForReportingButNotEnforced",
    "conditions": {
        "applications": {
            "includeApplications": [
                "All"
            ]
        },
        "users": {
            "includeUsers": [
                "All"
            ],
            "excludeGroups": [
                "{$GroupVars.BreakGlass}"
            ]
        },
        "clientAppTypes": [
            "exchangeActiveSync",
            "other"
        ]
    },
    "grantControls": {
        "operator": "OR",
        "builtInControls": [
            "block"
        ]
    },
    "description": "Foundation Cyber Essentials pack policy."
}
